rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && incoming().uid == request.auth.uid
        && incoming().email == request.auth.token.email
        && incoming().keys().hasAll(['uid', 'email', 'createdAt'])
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && incoming().updatedAt == request.time;
    }

    // Resumes collection
    match /resumes/{resumeId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      function isValidResume(data) {
        return data.userId == request.auth.uid
          && data.title is string && data.title.size() <= 200
          && data.templateId is string && data.templateId.size() <= 50;
      }

      allow create: if isSignedIn() 
        && isValidResume(incoming())
        && incoming().keys().hasAll(['userId', 'title', 'templateId', 'createdAt', 'updatedAt'])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn() 
        && isOwner(existing().userId)
        && isValidResume(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
